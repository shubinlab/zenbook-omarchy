#!/usr/bin/env bash
set -Eeuo pipefail

# Short ADHD-friendly command installed by install.sh into ~/.local/bin.
# Keep the repository as the single source of truth; this is only a launcher.

REPO_DIR="${OMARCHY_DIR:-${HOME}/zenbook-omarchy}"
BOOTSTRAP="${REPO_DIR}/scripts/bootstrap.sh"

die() {
  printf 'zenbook-omarchy: %s\n' "$*" >&2
  exit 1
}

[[ -x "${BOOTSTRAP}" ]] || die "profile checkout is missing: ${REPO_DIR}; run the GitHub installer once"

usage() {
  cat <<'EOF'
Usage: zenbook-omarchy [menu|all|vpn|display|packages|voice|bitwarden|diagnostics|terminal|update|doctor|check]

Short launcher for the local GitHub checkout. With no argument it opens a
small numbered menu. Bitwarden onboarding opens in a visible Foot window.
Extra options are passed to the selected stage.
EOF
}

open_menu_window() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v foot >/dev/null 2>&1 &&
     [[ -z "${ZENBOOK_OMARCHY_NO_NEW_WINDOW:-}" && -z "${ZENBOOK_OMARCHY_MENU_WINDOW:-}" ]]; then
    exec foot --title 'Zenbook Omarchy installer' bash -c '
      "$1" menu
      status=$?
      printf "\\nFinished (exit %s). Press Enter to close. " "$status"
      IFS= read -r
      exit "$status"
    ' bash "$0"
  fi
}

SELECTED_COMPONENTS=""

choose_components() {
  [[ -t 0 && -t 1 ]] || die 'run without arguments from a visible terminal, or choose a stage explicitly'
  while :; do
    printf '\nZenbook Omarchy — choose any combination\n\n'
    printf '  1  VPN / network\n'
    printf '  2  Display\n'
    printf '  3  Packages\n'
    printf '  4  Voice / NPU\n'
    printf '  5  Bitwarden\n'
    printf '  6  Terminal\n'
    printf '  7  Diagnostics\n'
    printf '  8  Omarchy system update (alone)\n'
    printf '\nDoctor runs automatically after every selection.\n'
    printf 'Enter numbers separated by spaces, or a for recommended restore, q to cancel: '
    local choice item component
    IFS= read -r choice
    case "${choice}" in
      q|Q) printf 'Cancelled.\n'; exit 0 ;;
      a|A) SELECTED_COMPONENTS='vpn,display,packages,voice,terminal,bitwarden'; break ;;
      *)
        local -a picks=() components=()
        read -r -a picks <<<"${choice}"
        for item in "${picks[@]}"; do
          case "${item}" in
            1) component=vpn ;;
            2) component=display ;;
            3) component=packages ;;
            4) component=voice ;;
            5) component=bitwarden ;;
            6) component=terminal ;;
            7) component=diagnostics ;;
            8) component=update ;;
            *) component='' ;;
          esac
          [[ -n "${component}" ]] || continue
          [[ " ${components[*]} " == *" ${component} "* ]] || components+=("${component}")
        done
        ((${#components[@]})) || { printf 'No valid components selected.\n'; continue; }
        SELECTED_COMPONENTS="$(IFS=','; printf '%s' "${components[*]}")"
        if [[ ",${SELECTED_COMPONENTS}," == *,update,* && ",${SELECTED_COMPONENTS}," != *,update, && "${SELECTED_COMPONENTS}" != update ]]; then
          printf 'System update must be selected alone; choose it separately.\n'
          continue
        fi
        break
        ;;
    esac
  done
  printf '\nSelected: %s\n' "${SELECTED_COMPONENTS}"
  if [[ "${SELECTED_COMPONENTS}" == *voice* || "${SELECTED_COMPONENTS}" == *bitwarden* ]]; then
    printf 'Added automatically: packages dependency.\n'
  fi
  printf 'Proceed once with this plan? [Y/n] '
  local confirm
  IFS= read -r confirm
  case "${confirm}" in
    n|N|no|NO) SELECTED_COMPONENTS=''; choose_components ;;
    *) ;;
  esac
}

run_bitwarden() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v foot >/dev/null 2>&1 &&
     [[ -z "${ZENBOOK_OMARCHY_NO_NEW_WINDOW:-}" ]]; then
    exec foot --title 'Zenbook Bitwarden setup' bash "${BOOTSTRAP}" \
      --profile auto --stage bitwarden "$@"
  fi
  exec "${BOOTSTRAP}" --profile auto --stage bitwarden "$@"
}

stage="${1:-menu}"
if [[ "${stage}" == menu ]]; then
  open_menu_window
  choose_components
  exec "${BOOTSTRAP}" --profile auto --stage selected --components "${SELECTED_COMPONENTS}"
else
  shift
fi

case "${stage}" in
  all|vpn|display|packages|voice|diagnostics|terminal|update|doctor)
    exec "${BOOTSTRAP}" --profile auto --stage "${stage}" "$@"
    ;;
  bitwarden)
    run_bitwarden "$@"
    ;;
  check)
    exec "${BOOTSTRAP}" --profile auto --check "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
