# Portable fallback profile. It installs common diagnostic tools and leaves
# monitor, VPN and other user state untouched.
PROFILE_ID="generic"
PROFILE_LABEL="Generic Omarchy host"
PROFILE_ENABLE_VPN=0
PROFILE_INSTALL_VPN_CLI=0
PROFILE_LOGIN_AFTER_VPN_INSTALL=0
PROFILE_MONITOR_CONFIG=""
PROFILE_TERMINAL_EXTENSION=""
PROFILE_VOICE_INSTALL=0
PROFILE_VOICE_EXTENSION=""
PROFILE_PACKAGE_MANIFESTS="packages/diagnostics.txt"
