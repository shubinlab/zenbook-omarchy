# ASUS Zenbook 14 UM3406KA profile. This is an example host profile consumed
# by the generic bootstrap engine; credentials and live machine state stay out
# of this file.
PROFILE_ID="zenbook-um3406ka"
PROFILE_LABEL="ASUS Zenbook 14 UM3406KA"
PROFILE_ENABLE_VPN=1
PROFILE_INSTALL_VPN_CLI=1
PROFILE_LOGIN_AFTER_VPN_INSTALL=1
PROFILE_MONITOR_CONFIG="monitors.lua"
PROFILE_TERMINAL_EXTENSION="terminal/apply.sh"
PROFILE_VOICE_INSTALL=1
PROFILE_VOICE_EXTENSION="voice/apply.sh"
# Voxtype and wtype are installed by Omarchy's native voice installer so that
# package/model/service ownership stays in one authoritative path.
# The clean flow relies on Omarchy's stock runtime packages and native
# installers. Diagnostics remain available through --stage diagnostics.
PROFILE_PACKAGE_MANIFESTS="packages/voice-npu.txt"
PROFILE_DIAGNOSTIC_MANIFESTS="packages/diagnostics.txt"
