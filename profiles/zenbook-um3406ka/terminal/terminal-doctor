#!/usr/bin/env bash

# Read-only health check for the user-owned terminal enhancements.
set -u

pass=0
warn=0
fail=0

ok() { printf 'PASS  %s\n' "$1"; ((pass += 1)); }
warning() { printf 'WARN  %s\n' "$1"; ((warn += 1)); }
bad() { printf 'FAIL  %s\n' "$1"; ((fail += 1)); }

check_cmd() {
  local name=$1
  if command -v "$name" >/dev/null 2>&1; then
    ok "$name: $(command -v "$name")"
  else
    bad "$name is not installed or not on PATH"
  fi
}

printf '%s\n' 'Terminal doctor (read-only)'
printf '%s\n' '=========================='

check_cmd foot
check_cmd fzf
check_cmd chafa
check_cmd tmux
check_cmd wl-copy

if foot --check-config >/dev/null 2>&1; then
  ok 'Foot configuration is valid'
else
  bad 'Foot configuration check failed'
fi

if grep -Eq '^[[:space:]]*sixel[[:space:]]*=[[:space:]]*yes[[:space:]]*$' \
    "$HOME/.config/foot/foot.ini" 2>/dev/null; then
  ok 'Foot Sixel is explicitly enabled'
else
  bad 'Foot Sixel is not explicitly enabled'
fi

if grep -Fq 'zenbook-omarchy Foot usability (managed)' "$HOME/.config/foot/foot.ini" 2>/dev/null &&
   grep -Fq 'search-start=F6' "$HOME/.config/foot/foot.ini" 2>/dev/null &&
   grep -Fq 'pipe-command-output=[wl-copy] F8' "$HOME/.config/foot/foot.ini" 2>/dev/null; then
  ok 'Foot usability bindings are installed'
else
  bad 'Foot usability bindings are missing'
fi

if [[ -x $HOME/.config/omarchy/hooks/theme-set.d/zenbook-terminal-tmux-theme ]] &&
   [[ -r $HOME/.config/tmux/omarchy-theme.conf ]] &&
   grep -Fq 'zenbook-omarchy tmux theme (managed)' "$HOME/.config/tmux/tmux.conf" 2>/dev/null; then
  ok 'Omarchy theme-set hook and tmux theme override are installed'
else
  bad 'Omarchy theme-set hook or tmux theme override is missing'
fi

if [[ -r $HOME/.local/share/blesh/ble.sh ]]; then
  version=$(grep -m1 '_ble_init_version=' "$HOME/.local/share/blesh/ble.sh" 2>/dev/null || true)
  ok "ble.sh is present${version:+ ($version)}"
else
  bad 'ble.sh is missing from ~/.local/share/blesh'
fi

if [[ -r $HOME/.local/share/zenbook-omarchy/blerc ]] &&
   grep -Fq 'zenbook-omarchy Bash selection (managed)' "$HOME/.local/share/zenbook-omarchy/blerc" &&
   grep -Fq "ble-bind -m emacs -f \$'raw:\\e[1;2D'" "$HOME/.local/share/zenbook-omarchy/blerc"; then
  ok 'keyboard selection bindings are installed'
else
  bad 'keyboard selection bindings are missing; rerun the terminal profile apply'
fi

if grep -q 'integration/fzf-completion' "$HOME/.blerc" 2>/dev/null &&
   grep -q 'integration/fzf-key-bindings' "$HOME/.blerc" 2>/dev/null; then
  ok 'ble.sh/fzf integration is configured'
else
  bad 'ble.sh/fzf integration is not configured'
fi

if [[ -x $HOME/.local/bin/omarchy-fzf-preview ]]; then
  ok 'fzf preview helper is executable'
else
  bad 'fzf preview helper is missing or not executable'
fi

if [[ -r $HOME/.bashrc ]] && grep -q 'zenbook-omarchy terminal' "$HOME/.bashrc" 2>/dev/null; then
  ok 'Bash integration is sourced from ~/.bashrc'
else
  bad 'Bash integration marker is missing'
fi

if grep -Fq 'grp:alt_shift_toggle_bidir' "$HOME/.config/hypr/input.lua" 2>/dev/null; then
  ok 'Keyboard switching remains compositor-owned Alt+Shift XKB'
else
  bad 'Keyboard switching ownership or Alt+Shift policy changed'
fi

if command -v omarchy-default-agent >/dev/null 2>&1; then
  agent=$(omarchy-default-agent 2>/dev/null || true)
  if [[ $agent == codex ]]; then
    ok 'Omarchy default agent: codex'
  elif [[ -n $agent ]]; then
    warning "Omarchy default agent: $agent"
  else
    bad 'Omarchy default agent is not set'
  fi
else
  bad 'omarchy-default-agent is unavailable'
fi

if ! grep -Eqi '^[[:space:]]*[^-].*(chatgpt|chat\.openai\.com|openai\.com)' "$HOME/.config/hypr/bindings.lua" 2>/dev/null; then
  ok 'Profile ChatGPT override is absent'
else
  bad 'Profile ChatGPT override is still configured; run profiles/zenbook-um3406ka/terminal/apply.sh --apply'
fi

printf '\n%s\n' "Summary: $pass passed, $warn warnings, $fail failures"
(( fail == 0 ))
