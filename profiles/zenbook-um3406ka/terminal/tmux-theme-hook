#!/usr/bin/env bash

set -Eeuo pipefail

output=${XDG_CONFIG_HOME:-$HOME/.config}/tmux/omarchy-theme.conf
if [[ ${1:-} == --write ]]; then
  output=${2:-$output}
elif [[ $# -gt 1 ]]; then
  printf 'Usage: %s [theme-name]\n' "$0" >&2
  exit 2
fi

color() {
  local name=$1 fallback=$2 value
  value=$(omarchy theme color "$name" 2>/dev/null || true)
  [[ ${value} =~ ^#[[:xdigit:]]{6}$ ]] && printf '%s' "$value" || printf '%s' "$fallback"
}

background=$(color background black)
foreground=$(color foreground white)
accent=$(color accent blue)
muted=$(color muted brightblack)

mkdir -p "$(dirname -- "$output")"
temporary=$(mktemp "${output}.tmp.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
cat >"$temporary" <<EOF
# Generated by zenbook-omarchy theme-set hook. Do not edit by hand.
set -g status-left "#[fg=${background},bg=${accent},bold] #S #[bg=default] "
set -g status-right "#[fg=${accent}]#{?pane_in_mode,COPY ,}#{?client_prefix,PREFIX ,}#{?window_zoomed_flag,ZOOM ,}#[fg=${muted}]#h "
set -g window-status-format "#[fg=${muted}] #I:#W "
set -g window-status-current-format "#[fg=${accent},bold] #I:#W "
set -g pane-border-style "fg=${muted}"
set -g pane-active-border-style "fg=${accent}"
set -g message-style "bg=default,fg=${accent}"
set -g message-command-style "bg=default,fg=${accent}"
set -g mode-style "bg=${accent},fg=${background}"
setw -g clock-mode-colour "${accent}"
EOF
install -m0644 "$temporary" "$output"
trap - EXIT

if tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "$output"
fi
