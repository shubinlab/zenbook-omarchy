# Only host-specific policy layered on top of native Omarchy Voxtype belongs
# here. Audio routing, service setup and Hyprland bindings remain owned by
# Omarchy. No credentials, recordings, model weights or absolute paths belong
# in Git.

VOICE_LANGUAGE="auto"
VOICE_TYPE_DELAY_MS="10"
# Voxtype remains the native capture/output frontend. Lemonade serves the
# actual Whisper inference locally through FastFlowLM on the AMD XDNA2 NPU.
VOICE_MODE="remote"
VOICE_REMOTE_ENDPOINT="http://127.0.0.1:13305"
VOICE_REMOTE_MODEL="whisper-v3-turbo-FLM"
# Conservative per-profile capture gain; the apply script backs up the old value.
VOICE_SOURCE_VOLUME_PERCENT="60"
