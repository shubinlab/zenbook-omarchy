# Native Omarchy voice profile for ASUS Zenbook UM3406KA.
# This file contains policy only: no credentials, recordings, model weights,
# or machine-specific absolute paths belong in Git.

VOICE_AUDIO_DEVICE="default"
VOICE_MODEL="large-v3-turbo"
VOICE_LANGUAGE="auto"
VOICE_VAD_THRESHOLD="0.5"
VOICE_PRE_TYPE_DELAY_MS="300"

# The installer discovers the current physical ALSA source/sink at apply time.
# Set these only for a deliberate host override after checking pactl output.
VOICE_PIPEWIRE_SOURCE_MASTER=""
VOICE_PIPEWIRE_SINK_MASTER=""
